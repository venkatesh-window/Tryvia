{
  "name": "tryvia-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cd mobile && npx expo start",
    "backend": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "seed": "cd backend && .\\venv\\Scripts\\python.exe seed.py",
    "web": "cd mobile && npx expo start --web",
    "android": "cd mobile && npx expo start --android",
    "ios": "cd mobile && npx expo start --ios"
  },
  "dependencies": {
    "expo": "^57.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
